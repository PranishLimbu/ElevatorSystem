<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Change the Server part only if your SQL Server instance has a different name -->
    <add name="ElevatorDb"
         connectionString="Server=localhost\SQLEXPRESS;Database=ElevatorDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=5" />
  </connectionStrings>
</configuration>
